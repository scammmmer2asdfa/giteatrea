# RepoLens environment configuration
# Copy this file to .env and fill in the values you need.

# Optional: a GitHub Personal Access Token used as a fallback when a user
# hasn't signed in. Increases the unauthenticated rate limit (60/hr -> 5000/hr).
# Create one at https://github.com/settings/tokens with "public_repo" scope (or no scope for public data only).
# Never commit real tokens.
VITE_GITHUB_TOKEN=

# GitHub OAuth App credentials (used by apps/api for the OAuth web flow).
# Create an OAuth App at https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Port for the local API server (apps/api), only needed for the OAuth flow.
API_PORT=8787
